POSTGRES_USER=prix_essence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=prix_essence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://prix_essence:changeme@postgres:5432/prix_essence

# A utiliser quand tu lances un script en local (hors Docker) depuis le venv,
# le service postgres etant alors joignable via localhost et non "postgres"
DATABASE_URL_LOCAL=postgresql://prix_essence:changeme@localhost:5432/prix_essence
